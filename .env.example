# ─── Database ─────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Auth ─────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# ─── LLM Provider ────────────────────────
LLM_PROVIDER="google"
GOOGLE_API_KEY="your-gemini-api-key"
GOOGLE_MODEL="gemini-1.5-pro"
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# Option 1: OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Option 2: Google Gemini
GOOGLE_API_KEY=""
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GOOGLE_MODEL="gemini-1.5-pro"

# Active LLM provider: "openai" or "google"
LLM_PROVIDER="google"

# ─── Social OAuth ────────────────────────
# Keep social login off until the production OAuth callback URLs are configured.
# Wallet login remains available either way.
ENABLE_SOCIAL_LOGIN="false"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ─── Social / Proof Verification ─────────
# Optional real ZK/social proof verifier. If unset in production, bounty claims fail unless mock mode is explicitly enabled.
ZKPASS_VERIFY_URL=""
ZKPASS_API_KEY=""
ENABLE_MOCK_ZK="false"

# ─── Blockchain / X Layer ────────────────
# X Layer Mainnet
XLAYER_RPC_URL="https://rpc.xlayer.tech"
XLAYER_CHAIN_ID="196"

# X Layer Testnet
XLAYER_TESTNET_RPC_URL="https://testrpc.xlayer.tech/terigon"
XLAYER_TESTNET_CHAIN_ID="1952"

# Contract Addresses (X Layer Testnet — deployed)
ESCROW_FACTORY_ADDRESS="0x07e6F24a981B7dfd92e82BAE0d5D5637fe798DE9"
REPUTATION_SBT_ADDRESS="0x9181cDb2341366E0cff16ecf42704286B9DB392A"
BOUNTY_POOL_ADDRESS="0xb3857aEd0bA0BC64d9332Bf71Cce1EA7A88fd8f6"

# USDT on X Layer (TestUSDT on testnet)
USDT_ADDRESS="0xfFA28F2d180f0069bEce5598762fff023CEdcFd2"
USDC_ADDRESS="0x74b7f16337b8972027f6196a17a631ac6de26d22"

# Platform deployer wallet private key (for contract deployment)
PRIVATE_KEY=""

# ─── Deployment ──────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used by runner.mjs when registering SkillMint services for review.
# Set to the deployed production app URL, for example https://skillmint.xyz.
SKILLMINT_API_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_CHAIN_ID="196"
NEXT_PUBLIC_XLAYER_RPC="https://rpc.xlayer.tech"
NEXT_PUBLIC_XLAYER_RPC_URL="https://rpc.xlayer.tech"

# Escrow sync now verifies deposits over RPC by default.
# Use this only for hackathon demos when RPC verification is intentionally unavailable.
ALLOW_UNVERIFIED_ESCROW_SYNC="false"

# Auto-Bot rental. Set treasury for real 50 USDT rental payments.
NEXT_PUBLIC_AUTOBOT_TREASURY_ADDRESS=""
NEXT_PUBLIC_AUTOBOT_PAYMENT_DECIMALS="18"
NEXT_PUBLIC_ENABLE_DEMO_AUTOBOT_RENTAL="false"
ENABLE_DEMO_AUTOBOT_RENTAL="false"
